# Copie para .env e ajuste. Não versione o .env.

# --- Banco ------------------------------------------------------------------
POSTGRES_USER=remedios
POSTGRES_PASSWORD=remedios
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=8000

# --- Firebase Authentication (obrigatório) ----------------------------------
# ID do projeto no console do Firebase (Configurações do projeto → Geral).
FIREBASE_PROJECT_ID=

# Configuração do app web no Firebase (Configurações do projeto → Seus apps → Web).
# Não são segredos: identificam o projeto para o navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# --- Notificações (Web Push) ------------------------------------------------
# Gere com: scripts/vapid-keys.sh >> .env   (a privada é segredo; trocar as
# chaves exige reativar as notificações em cada aparelho). SUBJECT: um contato.
REMEDIOS_VAPID_PUBLIC_KEY=
REMEDIOS_VAPID_PRIVATE_KEY=
REMEDIOS_VAPID_SUBJECT=mailto:troque@exemplo.com.br

# --- Modo local sem Firebase (opcional, só desenvolvimento) -----------------
# Descomente para aceitar tokens gerados por scripts/token-local.sh, assinados
# com a chave de TESTE do repositório. Nunca use em produção.
# FIREBASE_PROJECT_ID=remedios-local
# REMEDIOS_JWT_PUBLICKEY_LOCATION=/run/keys/test-public.pem
# VITE_AUTH_MODE=local
