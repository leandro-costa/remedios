# Copie para .env e ajuste. Os valores abaixo servem apenas para desenvolvimento.
POSTGRES_USER=remedios
POSTGRES_PASSWORD=remedios
POSTGRES_PORT=5432
API_PORT=8080

# Autenticação: emissor e chave pública (ou JWKS) do provedor OIDC.
# A chave padrão é a de TESTE do repositório — nunca use em produção.
REMEDIOS_JWT_ISSUER=https://remedios.local/dev
REMEDIOS_JWT_PUBLICKEY_FILE=./backend/src/test/resources/publicKey.pem
